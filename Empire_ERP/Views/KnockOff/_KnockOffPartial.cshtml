<style>
	.knockoff-heading {
		background-color: #055a87; /* 🔹 heading ka color */
		color: white; /* text color */
		padding: 2px 22px;
		margin-top: 20px;
		display: inline-block;
		clip-path: polygon(0 0, 88% 0, 100% 100%, 0% 100%); /* right side slope */
	}

	.billing-heading {
		background-color: #055a87; /* 🔹 heading ka color */
		color: white; /* text color */
		padding: 2px 22px;
		margin-top: 20px;
		display: inline-block;
		clip-path: polygon(0 0, 90% 0, 100% 100%, 0% 100%); /* right side slope */
	}

</style>
