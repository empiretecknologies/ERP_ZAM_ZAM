<div class="card">
    <div class="card-header">
        <button type="button" id="BtnNew" style="display:none" class="btn btn-primary btn-new waves-effect waves-light float-end"><i class="fa fa-plus"></i> Add New</button>
    </div>
    <div class="card-body Record">
        <div class="row">
            <div class="col-xl-2">
                <label class="form-label" for="Code">Code:</label>
                <input class="form-control" id="Code" readonly type="text" autocomplete="off">
            </div>
            <div class="col-xl-2">
                <label class="form-label" for="ASTATUS">Status:</label>
                <div id="ASTATUS"></div>
            </div>
            <div class="col-xl-4 mb-1">
                <label class="form-label" for="EMPLOYEE_ID">Employee:</label>
                <div id="EMPLOYEE_ID"></div>
                <input type="hidden" id="MACHINE_ID" />
            </div>
            <div class="col-xl-2 mb-1">
                <label class="form-label" for="PUNCH_DATE">Date:</label>
                <input class="form-control" id="PUNCH_DATE" onblur="empr_helper.FormatYear(this)" type="date" min="1500-01-01" max="2100-12-31" value="@DateTime.Now.Date.ToString("yyyy-MM-dd")" autocomplete="off">
            </div>
            <div class="col-xl-2 mb-1">
                <label class="form-label" for="PUNCH_TIME">Time:</label>
                <input class="form-control" id="PUNCH_TIME" type="time" autocomplete="off">
            </div>
            <div class="col-xl-4 mb-1">
                <label class="form-label" for="SHIFT_STATUS">Shift Status:</label>
                <div id="SHIFT_STATUS"></div>
            </div>
            <span class="span name-validation"></span>
            <div class="col-xl-12 text-end">
                <button class="btn btn-danger btn-delete" style="display:none" id="BtnDelete"><i class="fa fa-trash"></i> Delete</button>
                <button class="btn btn-primary btn-save" id="BtnSave"><i class="fa fa-save"></i> Save</button>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="card text-left">
                <div class="card-body">
                    <div class="table-responsive">
                        <div id="gridContainer"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section LinkScriptSection{
    <script type="text/javascript">
        var Permissions = @Html.Raw(Json.Serialize(ViewBag.Permissions));
    </script>
    <script src="~/js/customjs/empr_EmpManualAtt.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(function () {
            empr_EmpManualAtt.initEvents();
        });
    </script>
}
