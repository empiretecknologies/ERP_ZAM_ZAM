    }

    body {
        font-family: 'Roboto', sans-serif;
    }

    /*------------------  */
    .ci-user-picture {
        min-width: 150px;
        margin-right: 16px;
    }

        .ci-user-picture img {
            width: 150px;
            height: 150px;
            border-radius: 50%;
        }

    .filepreviewprofile {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
    }

    /*----modal--------*/
    .modal-header-bg {
        width: 100%;
        height: 12px;
        background: #055a87;
    }

    .cropImageModal .modal-dialog {
        max-width: 750px;
        width: 90%;
        margin: 0.5rem auto;
    }

    .up-photo-title {
        padding: 8px 15px;
        text-align: center;
    }

    #upload-demo {
        position: relative;
        width: 100%;
        height: 250px;
        padding-bottom: 0;
    }

    .croppie-container h5 {
        position: absolute;
        bottom: 4px;
        text-align: center;
        left: 0;
        right: 0;
        color: #fff;
        z-index: 2;
        font-size: 15px;
    }

    figure figcaption {
        position: absolute;
        bottom: 0;
        color: #fff;
        width: 100%;
        padding-left: 9px;
        padding-bottom: 5px;
        text-shadow: 0 0 10px #000;
    }

    .croppie-container .cr-image {
        right: 0;
    }

    .croppie-container .cr-slider-wrap {
        width: 275px;
    }

    .cr-slider-wrap p {
        font-size: 13px;
        color: #8D8D94;
        text-align: left;
    }

    .cr-slider {
        width: 275px;
    }

    .upload-action-btn {
        margin-top: 60px;
        padding-top: 40px;
    }

    .cr-slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 18px;
        height: 18px;
        background: #006AFA;
        cursor: pointer;
        box-shadow: 0px 0px 12px rgba(0, 0, 0, 0.25);
    }

    .cr-slider::-moz-range-thumb {
        width: 18px;
        height: 18px;
        background: #006AFA;
        cursor: pointer;
        box-shadow: 0px 0px 12px rgba(0, 0, 0, 0.25);
    }

    .cr-slider::-ms-thumb {
        width: 18px;
        height: 18px;
        background: #006AFA;
        cursor: pointer;
        box-shadow: 0px 0px 12px rgba(0, 0, 0, 0.25);
    }

    .cr-slider::-webkit-slider-runnable-track {
        width: 275px;
        height: 2px;
        cursor: pointer;
        box-shadow: none;
        background: #E0E0E0;
        border-radius: 3px;
        border: none;
    }

    .cr-slider:focus::-webkit-slider-runnable-track {
        background: #E0E0E0;
    }

    .cr-slider::-moz-range-track {
        width: 275px;
        height: 2px;
        cursor: pointer;
        box-shadow: none;
        background: #E0E0E0;
        border-radius: 3px;
        border: none;
    }

    .cr-slider::-ms-track {
        width: 275px;
        height: 2px;
        cursor: pointer;
        box-shadow: none;
        background: #E0E0E0;
        border-radius: 3px;
        border: none;
        color: transparent;
    }

    #gridContainer {
        max-height: 80vh; /* viewport height ka 70% */
        overflow-y: auto; /* vertical scroll enable */
    }

    #ItemBulkUploadModal .modal-dialog {
        max-width: 1100px;
    }

    #ItemBulkUploadModal .modal-body {
        min-height: 430px;
        padding-top: 12px;
        padding-bottom: 12px;
    }

    .item-bulk-steps {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 18px;
        padding-bottom: 12px;
        border-bottom: 1px solid #dee2e6;
        gap: 0;
    }

        .item-bulk-steps .item-bulk-step {
            display: flex;
            align-items: center;
            color: #6c757d;
            font-size: 14px;
            font-weight: 500;
        }

            .item-bulk-steps .item-bulk-step.active {
                color: var(--theme-blue);
                font-weight: 600;
            }

            .item-bulk-steps .item-bulk-step.done {
                color: var(--theme-blue);
            }

            .item-bulk-steps .item-bulk-step .item-bulk-step-no {
                display: inline-block;
                width: 26px;
                height: 26px;
                line-height: 24px;
                text-align: center;
                border: 1px solid #c5c5c5;
                margin-right: 8px;
                background: #fff;
                color: #6c757d;
                font-size: 13px;
            }

            .item-bulk-steps .item-bulk-step.active .item-bulk-step-no,
            .item-bulk-steps .item-bulk-step.done .item-bulk-step-no {
                background: var(--theme-blue);
                border-color: var(--theme-blue);
                color: #fff;
            }

        .item-bulk-steps .item-bulk-step-line {
            width: 90px;
            height: 1px;
            background: #c5c5c5;
            margin: 0 16px;
        }

        .item-bulk-steps .item-bulk-step.done + .item-bulk-step-line {
            background: var(--theme-blue);
        }

    .item-bulk-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
    }

        .item-bulk-toolbar .form-label {
            margin-bottom: 0;
            font-weight: 600;
        }

    .item-bulk-dropzone {
        position: relative;
        border: 1px dashed var(--theme-blue);
        background: #f8fafc;
        padding: 48px 20px 36px;
        text-align: center;
        cursor: pointer;
        min-height: 260px;
    }

        .item-bulk-dropzone.dragover {
            background: #eef6fa;
            border-style: solid;
        }

        .item-bulk-dropzone > i {
            color: var(--theme-blue);
            font-size: 38px;
            margin-bottom: 12px;
            display: block;
        }

        .item-bulk-dropzone .item-bulk-drop-title {
            font-size: 15px;
            font-weight: 600;
            color: #333;
        }

        .item-bulk-dropzone .item-bulk-drop-hint {
            font-size: 13px;
            color: #6c757d;
            margin-top: 4px;
            margin-bottom: 14px;
        }

    .item-bulk-file-name {
        margin-top: 12px;
        font-weight: 600;
        color: var(--theme-blue);
        min-height: 20px;
    }

    .item-bulk-busy {
        display: none;
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(248, 250, 252, 0.92);
        text-align: center;
        padding-top: 90px;
        z-index: 2;
        cursor: default;
    }

        .item-bulk-busy.show {
            display: block;
        }

        .item-bulk-busy i {
            color: var(--theme-blue);
            font-size: 26px;
        }

        .item-bulk-busy p {
            margin-top: 10px;
            margin-bottom: 0;
            font-weight: 600;
            color: var(--theme-blue);
        }

    .item-bulk-summary {
        display: flex;
        gap: 12px;
        margin-bottom: 14px;
    }

        .item-bulk-summary .item-bulk-summary-box {
            flex: 1;
            border: 1px solid #dee2e6;
            padding: 10px 14px;
            background: #fff;
        }

            .item-bulk-summary .item-bulk-summary-box span {
                display: block;
                font-size: 12px;
                color: #6c757d;
            }

            .item-bulk-summary .item-bulk-summary-box strong {
                font-size: 20px;
                color: var(--theme-blue);
            }

            .item-bulk-summary .item-bulk-summary-box.failed strong {
                color: var(--theme-red);
            }

    .item-bulk-review-block {
        margin-bottom: 12px;
    }

        .item-bulk-review-block .form-label {
            font-weight: 600;
        }

    #bulkSuccessGrid, #bulkFailedGrid {
        min-height: 170px;
        max-height: 230px;
    }

</style>
