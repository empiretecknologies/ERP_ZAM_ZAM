                        <div class="item-bulk-toolbar">
                            <label class="form-label">Select Excel file</label>
                            <button type="button" class="btn btn-light waves-effect waves-light" id="BtnDownloadItemBulkTemplate"><i class="fa fa-download"></i> Download Excel Template</button>
                        </div>
                        <div class="item-bulk-dropzone" id="itemBulkDropzone">
                            <i class="fa fa-file-excel"></i>
                            <div class="item-bulk-drop-title">Drop Excel file here</div>
                            <div class="item-bulk-drop-hint">or click Upload. Columns: ItemName, Category, Packing, Sale Rate</div>
                            <button type="button" class="btn btn-primary waves-effect waves-light" id="BtnSelectItemBulkFile"><i class="fa fa-upload"></i> Upload</button>
                            <div class="item-bulk-file-name" id="itemBulkFileName"></div>
                            <div class="item-bulk-busy" id="itemBulkBusy">
                                <i class="fa fa-spinner fa-spin"></i>
                                <p>Validating Excel file...</p>
                            </div>
                        </div>
                        <input type="file" id="ItemBulkUploadFile" accept=".xlsx,.xls" class="d-none" />
                    </div>
                    <div id="bulkStep2" style="display:none;">
                        <div class="item-bulk-summary">
                            <div class="item-bulk-summary-box">
                                <span>Successful Records</span>
                                <strong id="bulkSuccessCount">0</strong>
                            </div>
                            <div class="item-bulk-summary-box failed">
                                <span>Failed Records</span>
                                <strong id="bulkFailedCount">0</strong>
                            </div>
                        </div>
                        <div class="item-bulk-review-block">
                            <label class="form-label">Successful Records</label>
                            <div id="bulkSuccessGrid"></div>
                        </div>
                        <div class="item-bulk-review-block">
                            <label class="form-label">Failed Records</label>
                            <div id="bulkFailedGrid"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" id="BtnItemBulkBack" style="display:none;"><i class="fa fa-arrow-left"></i> Back</button>
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary" id="BtnItemBulkComplete" style="display:none;"><i class="fa fa-check"></i> Complete</button>
                </div>
            </div>
        </div>
    </div>
</div>

