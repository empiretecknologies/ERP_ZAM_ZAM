<style>
    #SodaPickGridContainer .dx-datagrid-rowsview .dx-selection.dx-row:not(.dx-row-focused) > td, .dx-datagrid-rowsview .dx-selection.dx-row:not(.dx-row-focused) > tr > td, .dx-datagrid-rowsview .dx-selection.dx-row:not(.dx-row-focused):hover > td, .dx-datagrid-rowsview .dx-selection.dx-row:not(.dx-row-focused):hover > tr > td {
        background-color: #055a87 !important;
        color: white;
    }
</style>
<div class="card">
    <div class="card-header">
        <button type="button" class="btn btn-light btn-search waves-effect waves-light" data-bs-toggle="modal"
                data-bs-target=".bs-example-modal-xl" id="BtnQuickSearch">
            <i class="fa fa-search"></i> Quick Search
        </button>
        <button type="button" class="btn btn-primary btn-new waves-effect waves-light float-end" id="BtnNew">
            <i class="fa fa-plus"></i> Add New
        </button>
    </div>
    <div class="card-body Record">
        <div class="row">
            <input id="ID" hidden />
            <input id="ACT_CODE" hidden />
            <input id="SACODE" hidden />
            <input id="partyhidden" hidden />
            <input id="acthidden" hidden />
            <input id="salesmanhidden" hidden />
            <input id="itemIdHidden" hidden />
            <div class="col-xl-3">
                <label class="form-label" for="Code">Code:</label>
                <input class="form-control" id="Code" readonly type="text" autocomplete="off">
            </div>
            <div class="col-xl-3">
                <label class="form-label" for="ASTATUS">Status:</label>
                <div id="ASTATUS"></div>
            </div>
            <div class="col-xl-3">
                <label class="form-label" for="V_DATE">Transaction Date:</label>
                <input class="form-control" id="V_DATE" type="date" value="@DateTime.Now.Date.ToString("yyyy-MM-dd")" autocomplete="off">
            </div>
            <div class="col-xl-3 vHide">
                <label class="form-label" for="VOUCHER_NO">Transaction #:</label>
                <input class="form-control" id="VOUCHER_NO" type="text" readonly autocomplete="off">
            </div>
            <div class="col-xl-3">
                <label class="form-label" for="REF">Reference No:</label>
                <input class="form-control" id="REF" type="text" autocomplete="off">
            </div>
            <div class="col-xl-3">
                <label class="form-label" for="PARTY_CODE">Party Type</label>
                <div id="PARTY_CODE"></div>
            </div>
            <div class="col-xl-3">
                <div class="row">
                    <div class="col-xl-6">
                        <label class="form-label" for="PARTY_BALANCE">Party Balance:</label>
                        <input class="form-control" readonly id="PARTY_BALANCE" type="text" autocomplete="off">
                    </div>
                    <div class="col-xl-6">
                        <label class="form-label" for="TERMS">Pay Terms:</label>
                        <input class="form-control" id="TERMS" type="text" autocomplete="off">
                    </div>
                </div>
            </div>


            <div class="col-xl-3">
                <div class="row">
                    <div class="col-xl-6">
                        <label class="form-label" for="DISC_RATE">Disc Rate:</label>
                        <input class="form-control" id="DISC_RATE" type="number" step="0.01" min="0" onkeydown="return !['e', 'E', '+', '-'].includes(event.key)" autocomplete="off">
                    </div>

                    <div class="col-xl-6">
                        <label class="form-label" for="DISC">Disc Amt:</label>
                        <input class="form-control" id="DISC" type="number" step="0.01" min="0" onkeydown="return !['e', 'E', '+', '-'].includes(event.key)" autocomplete="off">
                    </div>
                </div>
            </div>

            


            <div class="col-xl-3">
                <div class="row">
                    <div class="col-xl-8">
                        <label class="form-label" for="CACT"> Cash Account :</label>
                        <div id="CACT"></div>
                    </div>
                    <div class="col-xl-4">
                        <label class="form-label" for="CAMT">Amt:</label>
                        <input class="form-control" id="CAMT" type="text" autocomplete="off">
                    </div>
                </div>
            </div>
            <div class="col-xl-3">
                <div class="row">
                    <div class="col-xl-8">
                        <label class="form-label" for="BACT"> Bank Account :</label>
                        <div id="BACT"></div>
                    </div>
                    <div class="col-xl-4">
                        <label class="form-label" for="BAMT">Amt:</label>
                        <input class="form-control" id="BAMT" type="text" autocomplete="off">
                    </div>
                </div>
            </div>

            <div class="col-xl-3">
                <label class="form-label" for="CARTAGE">Cartage:</label>
                <input class="form-control" id="CARTAGE" type="number" step="0.01" min="0" onkeydown="return !['e', 'E', '+', '-'].includes(event.key)" autocomplete="off">
            </div>

            <div class="col-xl-3">
                <label class="form-label" for="DOC">Doc:</label>
                <input type="hidden" value="" id="hdnDOC" />
                <div class="input-group">
                    <input type="file" name="DOC" id="DOC" class="form-control" onchange="empr_PurchaseBill.UploadDoc()" accept=".pdf, .doc, .docx, .xls, .xlsx, image/*" />
                    <div class="input-group-append">
                        <a href="javascript:;" class="input-group-text" id="openDoc" onclick="empr_PurchaseBill.OpenDoc()">
                            <i class="fa fa-eye"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-xl-6">
                <label class="form-label" for="REMARKS">Comment</label>
                <textarea class="form-control" id="REMARKS" rows="1" type="text" autocomplete="off"></textarea>
            </div>
            
            
       
            
            <div class="col-x-12 pt-1 text-end">
                <button type="button" class="btn btn-primary btn-save mr-5" data-bs-toggle="modal" id="BtnSodaPick">
                    <i class="fa fa-search"></i> Pick Data
                </button>
                <button type="button" id="BtnPrint" class="btn btn-success btn-print waves-effect waves-light float-end">
                    <i class="fa fa-print"></i> Print
                </button>
            </div>
        </div>
        <ul class="nav nav-tabs nav-primary" id="pills-warningtab" role="tablist">
            <li class="nav-item detailInfo">
                <a class="nav-link active" id="pills-warninghome-tab" data-bs-toggle="pill"
                   href="#pills-warninghome" role="tab" aria-controls="pills-warninghome" aria-selected="true">
                    Detail Info
                </a>
            </li>
            <li class="nav-item commission" style="display:none;">
                <a class="nav-link" id="pills-Commission-tab" data-bs-toggle="pill"
                   href="#pills-Commission" role="tab" aria-controls="pills-Commission" aria-selected="false">
                    Commission
                </a>
            </li>
        </ul>

        <div class="tab-content" id="pills-warningtabContent">
            <!-- Detail Tab -->
            <div class="tab-pane fade show active" id="pills-warninghome" role="tabpanel"
                 aria-labelledby="pills-warninghome-tab">
                <div class="table-responsive">
                    <div class="my-3 d-flex justify-content-end align-items-center">
                        @if (ViewBag.Type == "B")
                        {
                            <div class="my-3">
                                <button type="button" class="btn btn-primary btn-save waves-light"
                                  
                                        style="z-index: 1001; position: relative;" id="pickItems">
                                    <i class="fa fa-search"></i> Size Set
                                </button>
                            </div>
                        }

                        <div class="d-flex align-items-center gap-2">
                            <input class="form-control" id="BARCODE" type="text" placeholder="Barcode &amp; QR Code" autocomplete="off" style="height: 28px;">
                            <button type="button" class="btn btn-primary waves-light" id="barcodeBtn" style="height: 28px;">Enter</button>
                        </div>
                       

                    </div>
                    <div id="DetailContainer"></div>
                </div>
            </div>

            <!-- Commission Tab -->
            <div class="tab-pane fade" id="pills-Commission" role="tabpanel"
                 aria-labelledby="pills-Commission-tab">
                <div class="table-responsive">
                    <div id="CommContainer"></div>
                </div>
            </div>
        </div>

    </div>
    <div class="col-xl-12 d-flex align-items-center justify-content-between pt-3 pb-3 pr-10">
        <!-- Left Side: Net Amount Input Field -->
        <div class="d-flex align-items-center ml-20" style="max-width: 320px; width: 100%;">
            <label for="NetAmount" class="fw-bold me-2 mb-0 text-nowrap" style="font-size: 15px; color: #333;">
                Net Amount:
            </label>
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-light fw-bold">RS</span>
                <input type="text" id="NetAmount" class="form-control text-end fw-bold fs-6" value="0.00" readonly
                       style="background-color: #f8f9fa; border-left: none; box-shadow: inset 0 1px 2px rgba(0,0,0,0.075); color: #055a87;">
            </div>
        </div>

        <!-- Right Side: Action Buttons -->
        <div>
            <button class="btn btn-danger btn-delete" id="BtnDelete" style="display:none">
                <i class="fa fa-trash"></i> Delete
            </button>
            <button class="btn btn-primary btn-save" id="BtnSave">
                <i class="fa fa-save"></i> Save
            </button>
        </div>
    </div>
    <div class="modal fade bs-example-modal-xl" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="myExtraLargeModalLabel">Quick Search</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="col-md-12">
                        <div class="card text-left">
                            <div class="card-body">
                                <div class="table-responsive">
                                    <div id="gridContainer"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div>

    <div class="modal fade" id="SodaPickModal" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="myExtraLargeModalLabel">Pick Soda</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="col-md-12">
                        <div class="card text-left">
                            <div class="card-body customHighlightForModifiedCells">
                                <div class="table-responsive">
                                    <div id="SodaPickGridContainer"></div>
                                </div>
                                 <div class="pt-3 text-end">
                                     <button type="button" class="btn btn-primary btn-new waves-effect waves-light float-end" id="BtnAddSodaToDelivery">
                                         <i class="fa fa-plus"></i> Add
                                     </button>
                                 </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div>

    <div class="modal fade" id="SodaPickDetailModal" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="myExtraLargeModalLabel">Pick Return Detail</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="col-md-12">
                        <div class="card text-left">
                            <div class="card-body customHighlightForModifiedCells">
                                <div class="table-responsive">
                                    <div id="SodaPickDetailGridContainer"></div>
                                </div>
                                 <div class="pt-3 text-end">
                                     <button type="button" class="btn btn-primary btn-new waves-effect waves-light float-end" id="BtnAddSodaDetailToDelivery">
                                         <i class="fa fa-plus"></i> Add
                                     </button>
                                 </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div>

    <div class="modal fade" id="BarcodePickModal" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-width">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="myExtraLargeModalLabel">Pick Barcodes</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="col-md-12">
                        <div class="card text-left">
                            <div class="card-body customHighlightForModifiedCells">
                                <div class="table-responsive">
                                    <div id="BarcodePickGridContainer"></div>
                                </div>
                                <div class="pt-3 text-end">
                                    <button type="button" class="btn btn-primary btn-new waves-effect waves-light float-end" id="BtnAddBarcodes">
                                        <i class="fa fa-plus"></i> Add
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div>

    <div class="modal fade bs-example-modal-lg" id="pickItemModel" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-md">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="myExtraLargeModalLabel">Pick Items</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="col-md-12">
                        <div class="card text-left">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-xl-12">
                                        <label class="form-label" for="PICK_ITEM">Items</label>
                                        <div id="PICK_ITEM"></div>
                                    </div>
                                    <div class="col-xl-12 mt-2">
                                        <label class="form-label" for="IQty">Quantity:</label>
                                        <input class="form-control" id="IQty" type="number" autocomplete="off">

                                    </div>
                                    <div class="col-xl-12 mt-2">
                                        <label class="form-label" for="IDISC">Discount %:</label>
                                        <input class="form-control" id="IDISC" type="number" autocomplete="off">

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="BtnGetItems" class="btn btn-primary btn-verify" type="button">Get Data</button>
                </div>
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div>


    <div class="modal fade bs-example-modal-xl" id="ShowReportModal" style="display:none" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="myExtraLargeModalLabel">Print Report</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="col-md-10">
                        <div class="row">
                            <div class="col-xl-4">
                                <label class="form-label" for="ReportType">ReportType:</label>
                                <div id="ReportType"></div>
                            </div>
                            <div class="col-xl-2 mt-20">
                                <button type="button" class="btn btn-primary mr-5" data-bs-toggle="modal" id="BtnGenerateReport">
                                    <i class="fa fa-file-arrow-down"></i> Get Report
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12 mt-3">
                        <div class="card text-left" id="ModalBody"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<input type="hidden" id="department_hidden" />
<input type="hidden" id="BARCODE_ID" />

<input type="hidden" id="displayExpr_department" />

@section LinkScriptSection {
    <script type="text/javascript">
        var PartyType = @Html.Raw(Json.Serialize(ViewBag.PartyType));
        var PartyTypeOld = @Html.Raw(Json.Serialize(ViewBag.PartyTypeOld));
        var ItemIds = @Html.Raw(Json.Serialize(ViewBag.ItemIds));
        var Salesman = @Html.Raw(Json.Serialize(ViewBag.Salesman));
        var Items = @Html.Raw(Json.Serialize(ViewBag.Items));
        var Units = @Html.Raw(Json.Serialize(ViewBag.Units));
        var Colors = @Html.Raw(Json.Serialize(ViewBag.Colors));
        var Sizes = @Html.Raw(Json.Serialize(ViewBag.Sizes));
        var Grades = @Html.Raw(Json.Serialize(ViewBag.Grades));
        var Warehouse = @Html.Raw(Json.Serialize(ViewBag.Warehouse));
        var Type = @Html.Raw(Json.Serialize(ViewBag.Type));
        var typeForm = @Html.Raw(Json.Serialize(ViewBag.FormType));
        var CompCond = @Html.Raw(Json.Serialize(ViewBag.CompCond));
        var Permissions = @Html.Raw(Json.Serialize(ViewBag.Permissions));
        var Limit = @Html.Raw(Json.Serialize(ViewBag.Limit));
        var todayDate = '@DateTime.Now.Date.ToString("yyyy-MM-dd")';
        var Parties = @Html.Raw(Json.Serialize(ViewBag.Parties));
        var dataClear = @Html.Raw(Json.Serialize(ViewBag.DATA_CLEAR));
        var StockList = @Html.Raw(Json.Serialize(ViewBag.StockList));
        var CashAccounts = @Html.Raw(Json.Serialize(ViewBag.CashAccounts));
        var BankAccounts = @Html.Raw(Json.Serialize(ViewBag.BankAccounts));

    </script>
    <script src="~/js/customjs/empr_PurchaseBill.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(function () {
            empr_PurchaseBill.InitEvents();
        });
    </script>
}